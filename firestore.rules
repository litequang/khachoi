rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isUserActive() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Users Collection
    match /users/{userId} {
      // Allow users to get their own document
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Allow active users to list/read all users
      allow read: if isSignedIn() && isUserActive();
      
      // Allow user to write their own profile, but prevent escalating privileges
      allow update: if isSignedIn() && request.auth.uid == userId && 
                    (!incoming().diff(existing()).affectedKeys().hasAny(['role', 'active']) || getUserRole() == 'ADMIN');

      // Admin can create/update/delete any user
      allow create, update, delete: if isSignedIn() && isUserActive() && getUserRole() == 'ADMIN';
    }

    // Tasks Collection
    match /tasks/{taskId} {
      // Any active user can read
      allow read: if isSignedIn() && isUserActive();

      // Create
      allow create: if isSignedIn() && isUserActive();

      // Update
      allow update: if isSignedIn() && isUserActive() && (
        // Action: Update Status (Designer / Sale / Admin)
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedByUid', 'updatedByName', 'designCompletedAt', 'sapoOrderedAt', 'noOrderAt', 'sapoOrderCode'])
          && incoming().status in ['DESIGNING', 'WAITING_DEPOSIT', 'SAPO_ORDERED', 'NO_ORDER']
          && incoming().updatedByUid == request.auth.uid
        )
        ||
        // Action: Designer Click Increment
        (
          getUserRole() == 'DESIGNER'
          && incoming().diff(existing()).affectedKeys().hasOnly(['linkClickCount', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && incoming().linkClickCount == existing().linkClickCount + 1
          && incoming().updatedByUid == request.auth.uid
        )
        ||
        // Action: Admin full overwrite (Restore Backup)
        (
          getUserRole() == 'ADMIN'
        )
      );

      // Delete (Admin only, though V1 says no need to delete, good to have admin power)
      allow delete: if isSignedIn() && isUserActive() && getUserRole() == 'ADMIN';
    }
  }
}
